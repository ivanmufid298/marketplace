# Copy to .env.local and fill in. Next.js reads these at BUILD time (and `next dev` start), so restart `npm run dev`
# or redeploy after changing them. See README, "Autentikasi dan akses admin".

# --- Supabase (required for real accounts and for /admin) ---------------------------------------------------------
# Both values are safe to expose to the browser: the publishable/anon key is limited by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Site address (OPTIONAL until the real domain is known) -----------------------------------------------------
# Used for absolute links in /sitemap.xml, link previews, and product structured data. No trailing slash needed.
# On Vercel it falls back to the project's production address; elsewhere it falls back to http://localhost:3000, so
# set it on any live host that is not Vercel, and as soon as the real domain is chosen.
NEXT_PUBLIC_SITE_URL=

# --- Demo mode (OPTIONAL, Vercel PREVIEW only) --------------------------------------------------------------------
# Leave empty everywhere except the Preview environment of Vercel. When Supabase is not configured:
#   - `npm run dev`                        -> demo login, open /admin (automatic, no flag needed)
#   - Vercel Preview + NEXT_PUBLIC_DEMO_MODE=1 -> demo login, open /admin, with a visible banner
#   - everything else (Production, Cloudflare, `npm start` on a laptop) -> login disabled and /admin locked
# NEVER set this on Production: demo mode accepts any email and password and leaves the admin panel open. The code
# also refuses it unless the build runs on a Vercel Preview deployment, but do not rely on that alone.
NEXT_PUBLIC_DEMO_MODE=

# --- Do NOT add a service role key here ---------------------------------------------------------------------------
# Nothing in the app needs it yet. If a server-only task ever does, name it SUPABASE_SERVICE_ROLE_KEY (no NEXT_PUBLIC_
# prefix, so it never reaches the browser) and keep it out of client components.
